<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AuralIndex_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="420" Height="420" Canvas.Left="-120" Canvas.Top="-80" Fill="#1A1B8D8A" />
            <Ellipse Width="360" Height="360" Canvas.Left="980" Canvas.Top="90" Fill="#140F6C7A" />
            <Ellipse Width="500" Height="500" Canvas.Left="880" Canvas.Top="520" Fill="#101B8D8A" />
        </Canvas>

        <NavigationView
            x:Name="Navigation"
            Margin="18"
            Background="#F7FFFFFF"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Visible"
            IsSettingsVisible="False"
            SelectionChanged="OnNavigationSelectionChanged"
            BackRequested="OnNavigationBackRequested">

            <NavigationView.Header>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Background="{StaticResource BrandWarmBrush}" CornerRadius="14" Padding="10">
                        <Image Width="24" Height="24">
                            <Image.Source>
                                <SvgImageSource x:Name="HeaderIcon" UriSource="ms-appx:///Assets/Icons/catalog.svg" />
                            </Image.Source>
                        </Image>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="AuralIndex" FontSize="13" Foreground="{StaticResource BrandMutedTextBrush}" />
                        <TextBlock
                            x:Name="HeaderTitle"
                            Text="Каталог аудіокниг"
                            FontSize="22"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.Header>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Каталог" Tag="catalog" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <ImageIcon><ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Icons/catalog.svg" /></ImageIcon.Source></ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Додавання / редагування" Tag="edit">
                    <NavigationViewItem.Icon>
                        <ImageIcon><ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Icons/edit-audiobook.svg" /></ImageIcon.Source></ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Розширений пошук" Tag="advanced-search">
                    <NavigationViewItem.Icon>
                        <ImageIcon><ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Icons/advanced-search.svg" /></ImageIcon.Source></ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Рекомендації" Tag="recommendations">
                    <NavigationViewItem.Icon>
                        <ImageIcon><ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Icons/recommendations.svg" /></ImageIcon.Source></ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Обране" Tag="favorites">
                    <NavigationViewItem.Icon>
                        <ImageIcon><ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Icons/favorites.svg" /></ImageIcon.Source></ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Історія" Tag="history">
                    <NavigationViewItem.Icon>
                        <ImageIcon><ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Icons/history.svg" /></ImageIcon.Source></ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Статистика" Tag="statistics">
                    <NavigationViewItem.Icon>
                        <ImageIcon><ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Icons/statistics.svg" /></ImageIcon.Source></ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Імпорт / експорт" Tag="import-export">
                    <NavigationViewItem.Icon>
                        <ImageIcon><ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Icons/import-export.svg" /></ImageIcon.Source></ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Налаштування" Tag="settings">
                    <NavigationViewItem.Icon>
                        <ImageIcon><ImageIcon.Source><SvgImageSource UriSource="ms-appx:///Assets/Icons/settings.svg" /></ImageIcon.Source></ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
