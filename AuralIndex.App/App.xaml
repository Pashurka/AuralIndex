<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AuralIndex_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AuralIndex_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="BrandAccentColor">#1B8D8A</Color>
            <Color x:Key="BrandAccentStrongColor">#0F6C7A</Color>
            <Color x:Key="BrandPanelColor">#F8FBFC</Color>
            <Color x:Key="BrandPanelBorderColor">#D8E6EA</Color>
            <Color x:Key="BrandWarmColor">#E7F4F4</Color>
            <Color x:Key="BrandMutedTextColor">#5B6B73</Color>

            <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
            <SolidColorBrush x:Key="BrandAccentStrongBrush" Color="{StaticResource BrandAccentStrongColor}" />
            <SolidColorBrush x:Key="BrandPanelBrush" Color="{StaticResource BrandPanelColor}" />
            <SolidColorBrush x:Key="BrandPanelBorderBrush" Color="{StaticResource BrandPanelBorderColor}" />
            <SolidColorBrush x:Key="BrandWarmBrush" Color="{StaticResource BrandWarmColor}" />
            <SolidColorBrush x:Key="BrandMutedTextBrush" Color="{StaticResource BrandMutedTextColor}" />

            <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F8FCFD" Offset="0" />
                <GradientStop Color="#EDF6F8" Offset="0.55" />
                <GradientStop Color="#F7FAFB" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="SurfaceCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrandPanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrandPanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,10" />
            </Style>

            <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="Background" Value="#FFFFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource BrandPanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="HeroTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="HeroSubtitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BrandMutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
