<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AuralIndex_App.Views.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:AuralIndex_App.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="24" RowDefinitions="Auto,Auto" RowSpacing="18">
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="Обране" Style="{StaticResource HeroTitleStyle}" />
                    <TextBlock
                        Text="Обране містить аудіокниги, до яких користувач хоче швидко повертатися. Це окремий персональний шар каталогу."
                        Style="{StaticResource HeroSubtitleStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="SummaryText" Text="Збережені аудіокниги" Style="{StaticResource SectionTitleStyle}" />
                    <ListView x:Name="FavoritesList" ItemsSource="{x:Bind Entries, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="OnFavoriteClick" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FavoriteRowVm">
                                <Border Margin="0,4,0,0" Padding="14" Background="#FFFFFFFF" BorderBrush="{StaticResource BrandPanelBorderBrush}" BorderThickness="1" CornerRadius="14">
                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="14">
                                        <Border Background="{StaticResource BrandWarmBrush}" CornerRadius="16" Padding="8">
                                            <Grid RowDefinitions="Auto,*">
                                                <TextBlock Text="{x:Bind GenreMark}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandAccentStrongBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Text="{x:Bind CoverInitials}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Column="1" ColumnDefinitions="3*,2*,1.5*,1.2*" RowDefinitions="Auto,Auto" RowSpacing="6">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Author}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Genre}" TextWrapping="Wrap" />
                                            <Border Grid.Column="3" Background="{StaticResource BrandWarmBrush}" CornerRadius="10" Padding="10,4" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind AddedAtText}" Foreground="{StaticResource BrandAccentStrongBrush}" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{x:Bind Language}" Foreground="{StaticResource BrandMutedTextBrush}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
