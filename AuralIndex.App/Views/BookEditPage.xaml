<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AuralIndex_App.Views.BookEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="24" RowDefinitions="Auto,Auto,Auto" RowSpacing="18" MaxWidth="980" HorizontalAlignment="Left">
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="Додавання / редагування аудіокниги" Style="{StaticResource HeroTitleStyle}" />
                    <TextBlock
                        Text="Заповни основні метадані аудіокниги. Ці дані використовуються для пошуку, рекомендацій, статистики та персоналізації."
                        Style="{StaticResource HeroSubtitleStyle}" />
                </StackPanel>
            </Border>

            <InfoBar
                Grid.Row="1"
                x:Name="ValidationBar"
                IsOpen="False"
                Severity="Error"
                Title="Перевірте дані" />

            <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <TextBox x:Name="TitleBox" Header="Назва" />
                        <TextBox x:Name="AuthorBox" Grid.Column="1" Header="Автор" />

                        <ComboBox x:Name="GenreBox" Grid.Row="1" Header="Жанр" PlaceholderText="Оберіть жанр">
                            <ComboBoxItem Content="Антиутопія" />
                            <ComboBoxItem Content="Біографія" />
                            <ComboBoxItem Content="Детектив" />
                            <ComboBoxItem Content="Історична проза" />
                            <ComboBoxItem Content="Класика" />
                            <ComboBoxItem Content="Наукова фантастика" />
                            <ComboBoxItem Content="Науково-популярна" />
                            <ComboBoxItem Content="Психологія" />
                            <ComboBoxItem Content="Роман" />
                            <ComboBoxItem Content="Фентезі" />
                        </ComboBox>
                        <ComboBox x:Name="LanguageBox" Grid.Row="1" Grid.Column="1" Header="Мова" PlaceholderText="Оберіть мову">
                            <ComboBoxItem Content="Українська" />
                            <ComboBoxItem Content="Англійська" />
                            <ComboBoxItem Content="Німецька" />
                            <ComboBoxItem Content="Французька" />
                            <ComboBoxItem Content="Польська" />
                        </ComboBox>

                        <NumberBox x:Name="YearBox" Grid.Row="2" Header="Рік" Minimum="0" SpinButtonPlacementMode="Inline" />
                        <NumberBox x:Name="DurationBox" Grid.Row="2" Grid.Column="1" Header="Тривалість, хв" Minimum="0" SpinButtonPlacementMode="Inline" />

                        <TextBox x:Name="NarratorBox" Grid.Row="3" Grid.ColumnSpan="2" Header="Диктор" />
                        <CheckBox x:Name="IsListenedCheckBox" Grid.Row="4" Grid.ColumnSpan="2" Content="Прослухано" />
                    </Grid>

                    <TextBox
                        x:Name="DescriptionBox"
                        Header="Опис"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="160" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Зберегти" Style="{StaticResource PrimaryActionButtonStyle}" Click="OnSaveClick" />
                        <Button Content="Скасувати" Style="{StaticResource SecondaryActionButtonStyle}" Click="OnCancelClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
