<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AuralIndex_App.Views.AdvancedSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:AuralIndex_App.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="24" RowDefinitions="Auto,Auto,*" RowSpacing="18">
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="Розширений пошук" Style="{StaticResource HeroTitleStyle}" />
                    <TextBlock
                        Text="Комбінуйте окремі метадані, щоб звузити пошук і отримати впорядковані за релевантністю результати."
                        Style="{StaticResource HeroSubtitleStyle}" />

                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                        <TextBox x:Name="TitleBox" Header="Назва" PlaceholderText="Наприклад: 1984" />
                        <TextBox x:Name="AuthorBox" Grid.Column="1" Header="Автор" PlaceholderText="Наприклад: Orwell" />
                        <TextBox x:Name="GenreBox" Grid.Column="2" Header="Жанр" PlaceholderText="Наприклад: Детектив" />

                        <TextBox x:Name="LanguageBox" Grid.Row="1" Header="Мова" PlaceholderText="Наприклад: Українська" />
                        <TextBox x:Name="NarratorBox" Grid.Row="1" Grid.Column="1" Header="Диктор" PlaceholderText="Ім'я диктора" />
                        <NumberBox x:Name="MaxDurationBox" Grid.Row="1" Grid.Column="2" Header="Макс. тривалість, хв" Minimum="0" SpinButtonPlacementMode="Inline" />

                        <NumberBox x:Name="YearFromBox" Grid.Row="2" Header="Рік від" Minimum="0" SpinButtonPlacementMode="Inline" />
                        <NumberBox x:Name="YearToBox" Grid.Row="2" Grid.Column="1" Header="Рік до" Minimum="0" SpinButtonPlacementMode="Inline" />

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
                            <Button Content="Знайти" Style="{StaticResource PrimaryActionButtonStyle}" Click="OnSearchClick" />
                            <Button Content="Очистити" Style="{StaticResource SecondaryActionButtonStyle}" Click="OnClearClick" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="14">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <Grid Padding="74,0,8,0" ColumnDefinitions="3*,2*,1.5*,1*,1*,1*">
                        <TextBlock Text="Назва" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Автор" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Жанр" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Мова" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Тривалість" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="Релевантність" FontWeight="SemiBold" />
                    </Grid>

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{x:Bind Books, Mode=OneWay}"
                        IsItemClickEnabled="True"
                        ItemClick="OnBookItemClick"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:AdvancedBookRowVm">
                                <Border Margin="0,4,0,0" Padding="14" Background="#FFFFFFFF" BorderBrush="{StaticResource BrandPanelBorderBrush}" BorderThickness="1" CornerRadius="14">
                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="14">
                                        <Border Background="{StaticResource BrandWarmBrush}" CornerRadius="16" Padding="8">
                                            <Grid RowDefinitions="Auto,*">
                                                <TextBlock Text="{x:Bind GenreMark}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandAccentStrongBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Text="{x:Bind CoverInitials}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Column="1" ColumnDefinitions="3*,2*,1.5*,1*,1*,1*">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Author}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Genre}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Language}" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind DurationText}" />
                                            <Border Grid.Column="5" Background="{StaticResource BrandWarmBrush}" CornerRadius="10" Padding="10,4" HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind ScoreText}" Foreground="{StaticResource BrandAccentStrongBrush}" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#00FFFFFF" />
        </Grid>
    </ScrollViewer>
</Page>
