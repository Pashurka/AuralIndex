<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AuralIndex_App.Views.RecommendationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:AuralIndex_App.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="24" RowDefinitions="Auto,Auto,Auto" RowSpacing="18">
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="Рекомендації" Style="{StaticResource HeroTitleStyle}" />
                    <TextBlock
                        Text="Персональна добірка формується на основі переглядів, обраного та збігів у жанрі, мові й авторах. Це окремий інтелектуальний шар системи, а не просто випадковий список книжок."
                        Style="{StaticResource HeroSubtitleStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Персональні рекомендації" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock
                        x:Name="PersonalHintText"
                        Text="Система аналізує обране, перегляди та пошукову активність, щоб підібрати релевантні книги."
                        Style="{StaticResource HeroSubtitleStyle}" />
                    <ListView x:Name="PersonalizedList" ItemsSource="{x:Bind PersonalizedRecommendations, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="OnRecommendationClick" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:RecommendationItemVm">
                                <Border Margin="0,4,0,0" Padding="16" Background="#FFFFFFFF" BorderBrush="{StaticResource BrandPanelBorderBrush}" BorderThickness="1" CornerRadius="16">
                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="14">
                                        <Border Background="{StaticResource BrandWarmBrush}" CornerRadius="16" Padding="8">
                                            <Grid RowDefinitions="Auto,*">
                                                <TextBlock Text="{x:Bind GenreMark}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandAccentStrongBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Text="{x:Bind CoverInitials}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Column="1" ColumnDefinitions="2.4*,1.8*,1.2*,1.2*" RowDefinitions="Auto,Auto" RowSpacing="6">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Genre}" Foreground="{StaticResource BrandMutedTextBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Author}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Language}" VerticalAlignment="Center" />
                                            <Border Grid.Column="3" Background="{StaticResource BrandWarmBrush}" CornerRadius="10" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind MatchLabel}" Foreground="{StaticResource BrandAccentStrongBrush}" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{x:Bind ExplanationText}" TextWrapping="Wrap" Foreground="{StaticResource BrandMutedTextBrush}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="NoPersonalizedText" Text="Поки що недостатньо даних для персоналізації. Відкрий кілька карток або додай книги в обране." Foreground="{StaticResource BrandMutedTextBrush}" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <InfoBar
                Grid.Row="2"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Де шукати схожі книги"
                Message="Підбір схожих аудіокниг для конкретного запису доступний у картці аудіокниги після відкриття її з каталогу або пошуку." />
        </Grid>
    </ScrollViewer>
</Page>
