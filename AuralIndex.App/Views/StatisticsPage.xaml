<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AuralIndex_App.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:AuralIndex_App.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="24" RowDefinitions="Auto,Auto,*" RowSpacing="18">
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="Статистика каталогу" Style="{StaticResource HeroTitleStyle}" />
                    <TextBlock
                        Text="Аналітика показує структуру локального каталогу: обсяг, розподіл за жанрами та мовами, а також авторів із найбільшою кількістю записів."
                        Style="{StaticResource HeroSubtitleStyle}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                <Border Style="{StaticResource SurfaceCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Усього книг" Foreground="{StaticResource BrandMutedTextBrush}" /><TextBlock x:Name="TotalBooksText" FontSize="32" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource SurfaceCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Жанрів" Foreground="{StaticResource BrandMutedTextBrush}" /><TextBlock x:Name="TotalGenresText" FontSize="32" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Мов" Foreground="{StaticResource BrandMutedTextBrush}" /><TextBlock x:Name="TotalLanguagesText" FontSize="32" FontWeight="SemiBold" /></StackPanel></Border>
                <Border Grid.Column="3" Style="{StaticResource SurfaceCardStyle}"><StackPanel Spacing="6"><TextBlock Text="Середня тривалість" Foreground="{StaticResource BrandMutedTextBrush}" /><TextBlock x:Name="AverageDurationText" FontSize="32" FontWeight="SemiBold" /></StackPanel></Border>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="18">
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Топ жанрів" Style="{StaticResource SectionTitleStyle}" />
                        <ListView ItemsSource="{x:Bind TopGenres, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:StatisticRowVm">
                                    <Border Margin="0,4,0,0" Padding="12" Background="#FFFFFFFF" BorderBrush="{StaticResource BrandPanelBorderBrush}" BorderThickness="1" CornerRadius="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{x:Bind Label}" />
                                            <Border Grid.Column="1" Background="{StaticResource BrandWarmBrush}" CornerRadius="10" Padding="10,4">
                                                <TextBlock Text="{x:Bind CountText}" Foreground="{StaticResource BrandAccentStrongBrush}" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Топ мов" Style="{StaticResource SectionTitleStyle}" />
                        <ListView ItemsSource="{x:Bind TopLanguages, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:StatisticRowVm">
                                    <Border Margin="0,4,0,0" Padding="12" Background="#FFFFFFFF" BorderBrush="{StaticResource BrandPanelBorderBrush}" BorderThickness="1" CornerRadius="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{x:Bind Label}" />
                                            <Border Grid.Column="1" Background="{StaticResource BrandWarmBrush}" CornerRadius="10" Padding="10,4">
                                                <TextBlock Text="{x:Bind CountText}" Foreground="{StaticResource BrandAccentStrongBrush}" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Топ авторів" Style="{StaticResource SectionTitleStyle}" />
                        <ListView ItemsSource="{x:Bind TopAuthors, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:StatisticRowVm">
                                    <Border Margin="0,4,0,0" Padding="12" Background="#FFFFFFFF" BorderBrush="{StaticResource BrandPanelBorderBrush}" BorderThickness="1" CornerRadius="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                                            <Border Grid.Column="1" Background="{StaticResource BrandWarmBrush}" CornerRadius="10" Padding="10,4">
                                                <TextBlock Text="{x:Bind CountText}" Foreground="{StaticResource BrandAccentStrongBrush}" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
